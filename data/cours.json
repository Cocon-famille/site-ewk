  {
    "id": "addition-colonnes",
    "titre": "Additionner en colonnes",
    "matiere": "Nombres",
    "slides": [
      {
        "type": "title",
        "eyebrow": "EWK &middot; Nombres",
        "title": "Additionner<br>en colonnes",
        "sub": "Comme à la grande école, avec des dizaines."
      },
      {
        "type": "info",
        "title": "Dizaines et unités",
        "body": "23, c'est 2 dizaines et 3 unités. La dizaine, c'est le chiffre de gauche&nbsp;; l'unité, c'est celui de droite."
      },
      {
        "type": "visual",
        "title": "23, ça fait quoi ?",
        "items": [
          {
            "big": "2",
            "label": "dizaines"
          },
          {
            "big": "3",
            "label": "unités"
          }
        ]
      },
      {
        "type": "info",
        "title": "Comment poser une addition",
        "body": "On écrit les unités sous les unités, et les dizaines sous les dizaines. On additionne d'abord les unités, puis les dizaines."
      },
      {
        "type": "visual",
        "title": "23 + 15",
        "items": [
          {
            "big": "23"
          },
          {
            "big": "+"
          },
          {
            "big": "15"
          },
          {
            "big": "="
          },
          {
            "big": "38",
            "highlight": true
          }
        ]
      },
      {
        "type": "info",
        "title": "Le détail du calcul",
        "body": "Unités&nbsp;: 3 + 5 = 8. Dizaines&nbsp;: 2 + 1 = 3. Résultat&nbsp;: 38."
      },
      {
        "type": "info",
        "title": "Soustraire, c'est pareil",
        "body": "45 - 23&nbsp;: on soustrait d'abord les unités (5 - 3 = 2), puis les dizaines (4 - 2 = 2). Résultat&nbsp;: 22."
      },
      {
        "type": "visual",
        "title": "45 - 23",
        "items": [
          {
            "big": "45"
          },
          {
            "big": "-"
          },
          {
            "big": "23"
          },
          {
            "big": "="
          },
          {
            "big": "22",
            "highlight": true
          }
        ]
      },
      {
        "type": "transition",
        "title": "Prêt pour un petit contrôle ?",
        "body": "On vérifie si tu sais additionner et soustraire en colonnes."
      },
